# Optional: used when you connect Python to PostgreSQL later.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_ops

# The Python scripts read these names. Put the real key only in .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mis_support
DB_USER=mis_user
DB_PASSWORD=

# OpenAI. Leave the key empty in this example. Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=
